def tborder():
    return Border(left=THIN, right=THIN, top=THIN, bottom=THIN)

def set_hdr(cell, text, width=None):
    cell.value     = text
    cell.fill      = HDR_FILL
    cell.font      = HDR_FONT
    cell.alignment = Alignment(horizontal="center", vertical="center")
    cell.border    = tborder()

def set_sub(cell, text):
    cell.value     = text
    cell.fill      = SUB_FILL
    cell.font      = SUB_FONT
    cell.alignment = Alignment(horizontal="center", vertical="center")
    cell.border    = tborder()


