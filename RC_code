HDR_FILL  = PatternFill("solid", fgColor="1F4E79")
HDR_FONT  = Font(name="Arial", bold=True, color="FFFFFF", size=10)
SUB_FILL  = PatternFill("solid", fgColor="2E75B6")
SUB_FONT  = Font(name="Arial", bold=True, color="FFFFFF", size=10)
ALT_FILL  = PatternFill("solid", fgColor="DDEEFF")
PASS_FILL = PatternFill("solid", fgColor="C6EFCE")
FAIL_FILL = PatternFill("solid", fgColor="FFC7CE")
PASS_FONT = Font(name="Arial", bold=True, color="006100", size=10)
FAIL_FONT = Font(name="Arial", bold=True, color="9C0006", size=10)
WARN_FILL = PatternFill("solid", fgColor="FFEB9C")
WARN_FONT = Font(name="Arial", bold=True, color="9C5700", size=10)
CELL_FONT = Font(name="Arial", size=10)
LBL_FONT  = Font(name="Arial", bold=True, size=10)
THIN = Side(style="thin", color="AAAAAA")
MED  = Side(style="medium", color="444444")
FACTOR_FILLS = [
    PatternFill("solid", fgColor="D9E1F2"),
    PatternFill("solid", fgColor="FFF2CC"),
    PatternFill("solid", fgColor="E2EFDA"),
    PatternFill("solid", fgColor="FCE4D6"),
    PatternFill("solid", fgColor="EAD1DC"),
    PatternFill("solid", fgColor="CFE2F3"),
]

def tborder(): return Border(left=THIN, right=THIN, top=THIN, bottom=THIN)

def shdr(cell, text):
    cell.value = text; cell.fill = HDR_FILL; cell.font = HDR_FONT
    cell.alignment = Alignment(horizontal="center", vertical="center")
    cell.border = tborder()

def ssub(cell, text):
    cell.value = text; cell.fill = SUB_FILL; cell.font = SUB_FONT
    cell.alignment = Alignment(horizontal="center", vertical="center")
    cell.border = tborder()


def write_not_found_workbook(wb, nrows, ncols, fl, strength, status,
                              elapsed, nodes, reasons, valid_row_count):
    ws = wb.active
    ws.title = "Search Result"
    ws.column_dimensions["A"].width = 80

    title_text = {
        'not_found': "EXHAUSTIVE SEARCH COMPLETE — Design Does NOT Exist",
        'timeout':   "SEARCH TIMED OUT — Result Inconclusive",
        'infeasible':"DESIGN IS INFEASIBLE — Divisibility Requirements Not Met",
    }[status]

    title_fill = {
        'not_found': PatternFill("solid", fgColor="FFC7CE"),
        'timeout':   PatternFill("solid", fgColor="FFEB9C"),
        'infeasible':PatternFill("solid", fgColor="FFC7CE"),
    }[status]

    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=3)
    tc = ws.cell(1, 1, title_text)
    tc.fill = title_fill
    tc.font = Font(name="Arial", bold=True, size=14,
                   color="9C0006" if status != 'timeout' else "9C5700")
    tc.alignment = Alignment(horizontal="center")
    ws.row_dimensions[1].height = 30

    r = 3
    def info(label, value, row):
        ws.cell(row, 1, label).font = LBL_FONT
        ws.cell(row, 2, str(value)).font = CELL_FONT
        ws.column_dimensions["B"].width = 40

    info("Parameters:", f"nrows={nrows}, ncols={ncols}, levels={fl}, strength={strength}", r); r+=1
    info("Search time:", f"{elapsed:.2f} seconds", r); r+=1
    info("Nodes explored:", f"{nodes:,}", r); r+=1
    info("Valid row configurations found:", valid_row_count, r); r+=1
    r += 1

    if status == 'infeasible':
        ws.cell(r, 1, "Why infeasible:").font = LBL_FONT; r+=1
        for reason in reasons:
            c = ws.cell(r, 1, f"  • {reason}")
            c.font = Font(name="Arial", size=10, color="9C0006"); r+=1
    elif status == 'not_found':
        ws.cell(r, 1, "Conclusion:").font = LBL_FONT; r+=1
        msg = (f"A {nrows}×{ncols} row-column factorial design with factor levels {fl} "
               f"and strength {strength} does NOT exist. The backtracking search exhaustively "
               f"explored all {nodes:,} possible row combinations and found no valid arrangement.")
        c = ws.cell(r, 1, msg)
        c.font = Font(name="Arial", size=10); c.alignment = Alignment(wrap_text=True)
        ws.row_dimensions[r].height = 50; r+=2
        ws.cell(r, 1, "What to try instead:").font = LBL_FONT; r+=1
        suggestions = [
            f"Increase nrows and/or ncols (next valid multiples satisfying divisibility).",
            f"Reduce the number of factors (fewer factors = less constraint).",
            f"Reduce strength from {strength} to {strength-1}." if strength > 1 else
            f"Check if the parameter combination has a known theoretical construction.",
        ]
        for s in suggestions:
            ws.cell(r, 1, f"  • {s}").font = Font(name="Arial", size=10, italic=True); r+=1
    elif status == 'timeout':
        ws.cell(r, 1, "What happened:").font = LBL_FONT; r+=1
        msg = (f"The search did not finish within the time limit. "
               f"This does NOT mean the design doesn't exist — the search space "
               f"may simply be too large. Try: increasing TIME_LIMIT, reducing parameters, "
               f"or using a different search strategy.")
        c = ws.cell(r, 1, msg)
        c.font = Font(name="Arial", size=10); c.alignment = Alignment(wrap_text=True)
        ws.row_dimensions[r].height = 50


def write_found_workbook(wb, array, nrows, ncols, fl, strength,
                          elapsed, nodes, ver_results, valid_row_count):
    k = len(fl)

    # ── Sheet 1: Design Array ────────────────────────────────────
    ws = wb.active
    ws.title = "Design Array"

    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=ncols + 1)
    t = ws.cell(1, 1,
        f"Row-Column Factorial Design  |  {nrows}×{ncols}  |  "
        f"Factors: {k}  |  Levels: {fl}  |  Strength: {strength}")
    t.font = Font(name="Arial", bold=True, size=13, color="1F3864")
    t.alignment = Alignment(horizontal="center")
    ws.row_dimensions[1].height = 26

    ws.cell(2, 1,
        f"Found by exhaustive backtracking search in {elapsed:.2f}s "
        f"({nodes:,} nodes, {valid_row_count} valid row templates)."
    ).font = Font(name="Arial", italic=True, size=9, color="444444")
    ws.row_dimensions[3].height = 5

    shdr(ws.cell(4, 1), "Row \\ Col")
    ws.column_dimensions["A"].width = 10
    cw = max(12, 3 * k + 4)
    for j in range(ncols):
        shdr(ws.cell(4, j + 2), f"C{j+1}")
        ws.column_dimensions[get_column_letter(j + 2)].width = cw

    for i in range(nrows):
        ssub(ws.cell(i + 5, 1), f"R{i+1}")
        for j in range(ncols):
            tup  = array[i][j]
            text = "(" + ",".join(str(v) for v in tup) + ")"
            c = ws.cell(i + 5, j + 2, text)
            c.font      = Font(name="Arial", size=10)
            c.alignment = Alignment(horizontal="center")
            c.border    = tborder()
            c.fill      = ALT_FILL if i % 2 == 0 else PatternFill()
        ws.row_dimensions[i + 5].height = 18

    # Design info block
    prod = 1
    for q in fl: prod *= q
    rep = (nrows * ncols) // prod
    ir = nrows + 7
    for off, (lbl, val) in enumerate([
        ("Rows:", nrows), ("Columns:", ncols), ("Factors:", k),
        ("Factor levels:", str(fl)), ("Strength:", strength),
        ("Total treatments:", prod), ("Array cells:", nrows * ncols),
        ("Each treatment repeats:", f"{rep}×"),
        ("Search time:", f"{elapsed:.3f}s"),
        ("Nodes explored:", f"{nodes:,}"),
    ]):
        ws.cell(ir + off, 1, lbl).font = LBL_FONT
        ws.cell(ir + off, 2, str(val)).font = CELL_FONT
    ws.column_dimensions["B"].width = 25

    # ── Sheet 2+: one sheet per factor ─────────────────────────
    for f in range(k):
        q    = fl[f]
        fill = FACTOR_FILLS[f % len(FACTOR_FILLS)]
        ws2  = wb.create_sheet(f"Factor {f+1} (q={q})")
        ws2.merge_cells(start_row=1, start_column=1, end_row=1, end_column=ncols + 1)
        ws2.cell(1, 1, f"Factor {f+1}  —  {q} levels  (0 to {q-1})"
            ).font = Font(name="Arial", bold=True, size=12, color="1F3864")
        ws2.cell(1, 1).alignment = Alignment(horizontal="center")
        shdr(ws2.cell(2, 1), "Row \\ Col")
        ws2.column_dimensions["A"].width = 10
        for j in range(ncols):
            shdr(ws2.cell(2, j + 2), f"C{j+1}")
            ws2.column_dimensions[get_column_letter(j + 2)].width = 9
        for i in range(nrows):
            ssub(ws2.cell(i + 3, 1), f"R{i+1}")
            for j in range(ncols):
                c = ws2.cell(i + 3, j + 2, array[i][j][f])
                c.fill = fill; c.font = Font(name="Arial", size=10, bold=True)
                c.alignment = Alignment(horizontal="center"); c.border = tborder()
            ws2.row_dimensions[i + 3].height = 18

    # ── Verification sheet ──────────────────────────────────────
    ws3 = wb.create_sheet("Verification")
    ws3.merge_cells(start_row=1, start_column=1, end_row=1, end_column=4)
    ws3.cell(1, 1, "Independent Verification of All Design Properties"
        ).font = Font(name="Arial", bold=True, size=13, color="1F3864")
    ws3.cell(1, 1).alignment = Alignment(horizontal="center")
    ws3.row_dimensions[1].height = 24
    ws3.column_dimensions["A"].width = 55
    ws3.column_dimensions["B"].width = 14
    ws3.column_dimensions["C"].width = 70

    for ci, txt in enumerate(["Property", "Result", "Interpretation"], 1):
        shdr(ws3.cell(3, ci), txt)

    r = 4
    def prow(label, ok, detail=""):
        ws3.cell(r, 1, label).font = CELL_FONT
        c = ws3.cell(r, 2, "PASS ✓" if ok else "FAIL ✗")
        c.fill, c.font = (PASS_FILL, PASS_FONT) if ok else (FAIL_FILL, FAIL_FONT)
        c.alignment = Alignment(horizontal="center")
        ws3.cell(r, 3, detail).font = Font(name="Arial", size=9, color="333333")
        ws3.row_dimensions[r].height = 18

    ok, rep = ver_results['treatment_balance']
    prow("Treatment balance — each treatment appears equally often", ok,
         f"Every treatment tuple appears exactly {rep} time(s)"); r+=1
    prow("Row marginal balance — each level appears equally in every row",
         ver_results['row_balance'],
         f"Each level of factor f appears ncols/q_f times in every row"); r+=1
    prow("Column marginal balance — each level appears equally in every column",
         ver_results['col_balance'],
         f"Each level of factor f appears nrows/q_f times in every column"); r+=1
    if strength >= 2:
        prow("Strength-2 (rows) — every ordered pair balanced in each row",
             ver_results.get('strength2_rows', False),
             "Fix any 2 factor positions: each ordered pair of levels appears equally in each row"); r+=1
        prow("Strength-2 (cols) — every ordered pair balanced in each column",
             ver_results.get('strength2_cols', False),
             "Fix any 2 factor positions: each ordered pair of levels appears equally in each column"); r+=1
    if strength >= 3:
        prow("Strength-3 (rows) — every ordered triplet balanced in each row",
             ver_results.get('strength3_rows', False),
             "Fix any 3 factor positions: each ordered triplet appears equally in each row"); r+=1
        prow("Strength-3 (cols) — every ordered triplet balanced in each column",
             ver_results.get('strength3_cols', False),
             "Fix any 3 factor positions: each ordered triplet appears equally in each column"); r+=1

    all_ok = all(v[0] if isinstance(v, tuple) else v for v in ver_results.values())
    r += 1
    ws3.merge_cells(start_row=r, start_column=1, end_row=r, end_column=3)
    c = ws3.cell(r, 1, "✓  ALL PROPERTIES VERIFIED" if all_ok else "✗  VERIFICATION FAILED")
    c.fill = PASS_FILL if all_ok else FAIL_FILL
    c.font = Font(name="Arial", bold=True, size=12,
                  color="006100" if all_ok else "9C0006")
    c.alignment = Alignment(horizontal="center")
    ws3.row_dimensions[r].height = 24

    # ── Row frequency sheet ─────────────────────────────────────
    write_freq_sheet(wb, array, nrows, ncols, fl, "row")
    write_freq_sheet(wb, array, nrows, ncols, fl, "col")

    # ── Pair frequency sheets ───────────────────────────────────
    if strength >= 2:
        write_pair_sheet(wb, array, nrows, ncols, fl, "row")
        write_pair_sheet(wb, array, nrows, ncols, fl, "col")

    if strength >= 3:
        write_triplet_sheet(wb, array, nrows, ncols, fl, "row")
        write_triplet_sheet(wb, array, nrows, ncols, fl, "col")


def write_freq_sheet(wb, array, nrows, ncols, fl, by):
    label = "Row" if by == "row" else "Col"
    ws = wb.create_sheet(f"{label} Freq")
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=12)
    ws.cell(1, 1, f"Level Frequency per {label}  —  Marginal Balance Check"
        ).font = Font(name="Arial", bold=True, size=12, color="1F3864")
    ws.cell(1, 1).alignment = Alignment(horizontal="center")
    k = len(fl); cur = 3; outer = nrows if by == "row" else ncols

    for f in range(k):
        q = fl[f]; fill = FACTOR_FILLS[f % len(FACTOR_FILLS)]
        ws.cell(cur, 1, f"Factor {f+1}  ({q} levels)").font = LBL_FONT; cur += 1
        shdr(ws.cell(cur, 1), label); ws.column_dimensions["A"].width = 10
        for v in range(q):
            shdr(ws.cell(cur, v + 2), f"Level {v}")
            ws.column_dimensions[get_column_letter(v + 2)].width = 10
        shdr(ws.cell(cur, q + 2), "Uniform?")
        ws.column_dimensions[get_column_letter(q + 2)].width = 11
        cur += 1
        quota = (ncols if by == "row" else nrows) // q
        for idx in range(outer):
            if by == "row":
                cnt = Counter(array[idx][j][f] for j in range(ncols))
            else:
                cnt = Counter(array[i][idx][f] for i in range(nrows))
            ssub(ws.cell(cur, 1), f"{'R' if by=='row' else 'C'}{idx+1}")
            vals = [cnt.get(v, 0) for v in range(q)]
            unif = len(set(vals)) == 1 and all(v == quota for v in vals)
            for v in range(q):
                c = ws.cell(cur, v + 2, vals[v]); c.fill = fill
                c.font = Font(name="Arial", size=10)
                c.alignment = Alignment(horizontal="center"); c.border = tborder()
            c2 = ws.cell(cur, q + 2, "YES ✓" if unif else "NO ✗")
            c2.fill, c2.font = (PASS_FILL, PASS_FONT) if unif else (FAIL_FILL, FAIL_FONT)
            c2.alignment = Alignment(horizontal="center"); cur += 1
        cur += 1


def write_pair_sheet(wb, array, nrows, ncols, fl, by):
    label = "Row" if by == "row" else "Col"
    ws = wb.create_sheet(f"Pair Freq ({label})")
    k = len(fl); outer = nrows if by == "row" else ncols
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=16)
    ws.cell(1, 1, f"Ordered-Pair Frequencies per {label}  —  Strength-2 Check"
        ).font = Font(name="Arial", bold=True, size=12, color="1F3864")
    ws.cell(1, 1).alignment = Alignment(horizontal="center")
    cur = 3; quota = (ncols if by=="row" else nrows)

    for f1, f2 in itertools.combinations(range(k), 2):
        q1, q2 = fl[f1], fl[f2]
        pairs = list(itertools.product(range(q1), range(q2)))
        pq = quota // (q1 * q2)
        ws.cell(cur, 1, f"Factors {f1+1} × {f2+1}   ({q1}×{q2} = {q1*q2} ordered pairs,"
                        f" quota per {label.lower()} = {pq})"
            ).font = LBL_FONT; cur += 1
        shdr(ws.cell(cur, 1), label); ws.column_dimensions["A"].width = 9
        for pi, (a, b) in enumerate(pairs):
            shdr(ws.cell(cur, pi + 2), f"({a},{b})")
            ws.column_dimensions[get_column_letter(pi + 2)].width = 8
        shdr(ws.cell(cur, len(pairs) + 2), "Uniform?")
        ws.column_dimensions[get_column_letter(len(pairs) + 2)].width = 11
        cur += 1

        for idx in range(outer):
            if by == "row":
                cnt = Counter((array[idx][j][f1], array[idx][j][f2]) for j in range(ncols))
            else:
                cnt = Counter((array[i][idx][f1], array[i][idx][f2]) for i in range(nrows))
            ssub(ws.cell(cur, 1), f"{'R' if by=='row' else 'C'}{idx+1}")
            vals = [cnt.get(p, 0) for p in pairs]
            ok   = (set(cnt.keys()) == set(pairs)) and all(v == pq for v in vals)
            fill = PASS_FILL if ok else FAIL_FILL
            for pi, p in enumerate(pairs):
                c = ws.cell(cur, pi + 2, cnt.get(p, 0))
                c.fill = fill; c.font = Font(name="Arial", size=9)
                c.alignment = Alignment(horizontal="center"); c.border = tborder()
            c2 = ws.cell(cur, len(pairs) + 2, "YES ✓" if ok else "NO ✗")
            c2.fill, c2.font = (PASS_FILL, PASS_FONT) if ok else (FAIL_FILL, FAIL_FONT)
            c2.alignment = Alignment(horizontal="center"); cur += 1
        cur += 1


def write_triplet_sheet(wb, array, nrows, ncols, fl, by):
    label = "Row" if by == "row" else "Col"
    ws = wb.create_sheet(f"Triplet Freq ({label})")
    k = len(fl); outer = nrows if by == "row" else ncols
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=20)
    ws.cell(1, 1, f"Ordered-Triplet Frequencies per {label}  —  Strength-3 Check"
        ).font = Font(name="Arial", bold=True, size=12, color="1F3864")
    ws.cell(1, 1).alignment = Alignment(horizontal="center")
    cur = 3; quota = ncols if by == "row" else nrows

    for f1, f2, f3 in itertools.combinations(range(k), 3):
        q1, q2, q3 = fl[f1], fl[f2], fl[f3]
        trips = list(itertools.product(range(q1), range(q2), range(q3)))
        tq = quota // (q1 * q2 * q3)
        ws.cell(cur, 1, f"Factors {f1+1}×{f2+1}×{f3+1}  ({q1*q2*q3} ordered triplets, quota={tq})"
            ).font = LBL_FONT; cur += 1
        shdr(ws.cell(cur, 1), label); ws.column_dimensions["A"].width = 9
        for ti, tpl in enumerate(trips):
            shdr(ws.cell(cur, ti + 2), str(tpl))
            ws.column_dimensions[get_column_letter(ti + 2)].width = 9
        shdr(ws.cell(cur, len(trips) + 2), "Uniform?")
        ws.column_dimensions[get_column_letter(len(trips) + 2)].width = 11
        cur += 1

        for idx in range(outer):
            if by == "row":
                cnt = Counter((array[idx][j][f1], array[idx][j][f2], array[idx][j][f3])
                               for j in range(ncols))
            else:
                cnt = Counter((array[i][idx][f1], array[i][idx][f2], array[i][idx][f3])
                               for i in range(nrows))
            ssub(ws.cell(cur, 1), f"{'R' if by=='row' else 'C'}{idx+1}")
            vals = [cnt.get(tp, 0) for tp in trips]
            ok   = (set(cnt.keys()) == set(trips)) and all(v == tq for v in vals)
            fill = PASS_FILL if ok else FAIL_FILL
            for ti, tp in enumerate(trips):
                c = ws.cell(cur, ti + 2, cnt.get(tp, 0))
                c.fill = fill; c.font = Font(name="Arial", size=9)
                c.alignment = Alignment(horizontal="center"); c.border = tborder()
            c2 = ws.cell(cur, len(trips) + 2, "YES ✓" if ok else "NO ✗")
            c2.fill, c2.font = (PASS_FILL, PASS_FONT) if ok else (FAIL_FILL, FAIL_FONT)
            c2.alignment = Alignment(horizontal="center"); cur += 1
        cur += 1


