# ── Maths helpers ────────────────────────────────────────────────

def lcm2(a, b): return a * b // gcd(a, b)
def lcm_list(lst): return reduce(lcm2, lst)

def required_divisors(factor_levels, strength):
    """Return the set of integers that must divide nrows and ncols."""
    k  = len(factor_levels)
    divs = set(factor_levels)
    if strength >= 2:
        for i, j in itertools.combinations(range(k), 2):
            divs.add(factor_levels[i] * factor_levels[j])
    if strength >= 3:
        for i, j, kk in itertools.combinations(range(k), 3):
            divs.add(factor_levels[i] * factor_levels[j] * factor_levels[kk])
    return divs

def minimum_dimension(factor_levels, strength):
    divs = required_divisors(factor_levels, strength)
    return lcm_list(sorted(divs))

def check_divisibility(nrows, ncols, factor_levels, strength):
    """Raise ValueError with a clear message if dimensions are invalid."""
    divs = required_divisors(factor_levels, strength)
    errors = []
    for d in sorted(divs):
        if nrows % d != 0:
            errors.append(f"nrows={nrows} is not divisible by {d}")
        if ncols % d != 0:
            errors.append(f"ncols={ncols} is not divisible by {d}")
    if errors:
        min_d = minimum_dimension(factor_levels, strength)
        raise ValueError(
            "Divisibility requirements not met for strength-"
            f"{strength} design with levels {factor_levels}:\n"
            + "\n".join(f"  • {e}" for e in errors)
            + f"\n\nMinimum valid dimension for this configuration: {min_d}×{min_d}."
            + "\nSet NUM_ROWS = NUM_COLS = "
            + str(min_d)
            + " (or any multiple of "
            + str(min_d)
            + ")."
        )


# ── Design construction ──────────────────────────────────────────

def _first_coprime(q):
    """Smallest integer in [1, q] that is coprime to q."""
    for c in range(1, q + 1):
        if gcd(c, q) == 1:
            return c
    return 1

def build_design(nrows, ncols, factor_levels):
    """
    Generalised cyclic construction:
      cell(i, j)[f] = (i + c_f * j)  mod  q_f
    where c_f is coprime to q_f.
    This guarantees:
      - every level of factor f appears ncols/q_f times in each row  (vary j, fix i)
      - every level of factor f appears nrows/q_f times in each col  (vary i, fix j)
      - strength-2 / strength-3 properties follow from the divisibility conditions.
    """
    k  = len(factor_levels)
    col_coeffs = [_first_coprime(q) for q in factor_levels]

    array = []
    for i in range(nrows):
        row = []
        for j in range(ncols):
            cell = tuple(
                (i + col_coeffs[f] * j) % factor_levels[f]
                for f in range(k)
            )
            row.append(cell)
        array.append(row)
    return array


# ── Verification ─────────────────────────────────────────────────

def verify(array, nrows, ncols, factor_levels, strength):
    k = len(factor_levels)
    R = {}

    # 1. Treatment balance
    all_cells = [array[i][j] for i in range(nrows) for j in range(ncols)]
    counts    = Counter(all_cells)
    freqs     = list(counts.values())
    R["treatment_balance"] = (len(set(freqs)) == 1, counts)

    # 2. Row marginal balance
    row_ok = True
    for f in range(k):
        for i in range(nrows):
            c = Counter(array[i][j][f] for j in range(ncols))
            if len(set(c.values())) != 1:
                row_ok = False
    R["row_factor_balance"] = row_ok

    # 3. Col marginal balance
    col_ok = True
    for f in range(k):
        for j in range(ncols):
            c = Counter(array[i][j][f] for i in range(nrows))
            if len(set(c.values())) != 1:
                col_ok = False
    R["col_factor_balance"] = col_ok

    # 4. Strength-2
    if strength >= 2:
        s2r = s2c = True
        for f1, f2 in itertools.combinations(range(k), 2):
            for i in range(nrows):
                c = Counter((array[i][j][f1], array[i][j][f2]) for j in range(ncols))
                if len(set(c.values())) != 1: s2r = False
            for j in range(ncols):
                c = Counter((array[i][j][f1], array[i][j][f2]) for i in range(nrows))
                if len(set(c.values())) != 1: s2c = False
        R["strength2_rows"] = s2r
        R["strength2_cols"] = s2c

    # 5. Strength-3
    if strength >= 3:
        s3r = s3c = True
        for f1, f2, f3 in itertools.combinations(range(k), 3):
            for i in range(nrows):
                c = Counter((array[i][j][f1], array[i][j][f2], array[i][j][f3]) for j in range(ncols))
                if len(set(c.values())) != 1: s3r = False
            for j in range(ncols):
                c = Counter((array[i][j][f1], array[i][j][f2], array[i][j][f3]) for i in range(nrows))
                if len(set(c.values())) != 1: s3c = False
        R["strength3_rows"] = s3r
        R["strength3_cols"] = s3c

    return R


