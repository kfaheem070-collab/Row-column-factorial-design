# ────────────────────────────────────────────────────────────────
#  Feasibility checks
# ────────────────────────────────────────────────────────────────

def feasibility_check(nrows, ncols, fl, strength):
    """
    Return (ok, list_of_reasons_why_infeasible).
    Checks necessary divisibility conditions.
    These are NECESSARY but not sufficient — a design may still not exist
    even when these pass.
    """
    k = len(fl)
    reasons = []
    N = nrows * ncols
    prod = 1
    for q in fl: prod *= q
    if N % prod != 0:
        reasons.append(
            f"nrows×ncols = {N} must be divisible by product of all levels "
            f"({prod}) for treatment balance.")

    for q in fl:
        if ncols % q != 0:
            reasons.append(f"ncols={ncols} must be divisible by {q} (row marginal balance).")
        if nrows % q != 0:
            reasons.append(f"nrows={nrows} must be divisible by {q} (column marginal balance).")

    if strength >= 2:
        for f1, f2 in itertools.combinations(range(k), 2):
            q1, q2 = fl[f1], fl[f2]
            if ncols % (q1 * q2) != 0:
                reasons.append(
                    f"ncols={ncols} must be divisible by {q1}×{q2}={q1*q2} "
                    f"(strength-2 row balance for factors {f1+1},{f2+1}).")
            if nrows % (q1 * q2) != 0:
                reasons.append(
                    f"nrows={nrows} must be divisible by {q1}×{q2}={q1*q2} "
                    f"(strength-2 column balance for factors {f1+1},{f2+1}).")

    if strength >= 3:
        for f1, f2, f3 in itertools.combinations(range(k), 3):
            q1, q2, q3 = fl[f1], fl[f2], fl[f3]
            prod3 = q1 * q2 * q3
            if ncols % prod3 != 0:
                reasons.append(
                    f"ncols={ncols} must be divisible by {q1}×{q2}×{q3}={prod3} "
                    f"(strength-3, factors {f1+1},{f2+1},{f3+1}).")
            if nrows % prod3 != 0:
                reasons.append(
                    f"nrows={nrows} must be divisible by {q1}×{q2}×{q3}={prod3} "
                    f"(strength-3, factors {f1+1},{f2+1},{f3+1}).")

    return (len(reasons) == 0), reasons


# ────────────────────────────────────────────────────────────────
#  Step 1 — generate all valid row configurations
# ────────────────────────────────────────────────────────────────

def generate_valid_rows(ncols, fl, strength):
    """
    Build every length-ncols sequence of treatment tuples that satisfies:
      - Row marginal balance for every factor
      - Row strength-t balance for every t-subset of factors (t ≤ strength)
    Uses backtracking so it is fast even for moderate ncols.
    Returns a list of tuples-of-tuples.
    """
    k = len(fl)
    all_treatments = list(itertools.product(*[range(q) for q in fl]))

    rq = [ncols // q for q in fl]

    pair_keys = list(itertools.combinations(range(k), 2)) if strength >= 2 else []
    trip_keys = list(itertools.combinations(range(k), 3)) if strength >= 3 else []
    pq = {(f1, f2): ncols // (fl[f1] * fl[f2]) for f1, f2 in pair_keys}
    tq = {(f1, f2, f3): ncols // (fl[f1] * fl[f2] * fl[f3]) for f1, f2, f3 in trip_keys}

    valid = []
    cur   = []
    lev   = [Counter() for _ in range(k)]
    pc    = {key: Counter() for key in pair_keys}
    tc    = {key: Counter() for key in trip_keys}

    def bt(pos):
        if pos == ncols:
            valid.append(tuple(cur))
            return
        for t in all_treatments:
            # --- level upper bounds ---
            ok = True
            for f in range(k):
                if lev[f][t[f]] + 1 > rq[f]:
                    ok = False; break
            if not ok:
                continue
            # --- pair upper bounds ---
            for f1, f2 in pair_keys:
                if pc[(f1, f2)][(t[f1], t[f2])] + 1 > pq[(f1, f2)]:
                    ok = False; break
            if not ok:
                continue
            # --- triplet upper bounds ---
            for f1, f2, f3 in trip_keys:
                if tc[(f1, f2, f3)][(t[f1], t[f2], t[f3])] + 1 > tq[(f1, f2, f3)]:
                    ok = False; break
            if not ok:
                continue
            # --- place ---
            cur.append(t)
            for f in range(k):
                lev[f][t[f]] += 1
            for f1, f2 in pair_keys:
                pc[(f1, f2)][(t[f1], t[f2])] += 1
            for f1, f2, f3 in trip_keys:
                tc[(f1, f2, f3)][(t[f1], t[f2], t[f3])] += 1

            bt(pos + 1)

            cur.pop()
            for f in range(k):
                lev[f][t[f]] -= 1
            for f1, f2 in pair_keys:
                pc[(f1, f2)][(t[f1], t[f2])] -= 1
            for f1, f2, f3 in trip_keys:
                tc[(f1, f2, f3)][(t[f1], t[f2], t[f3])] -= 1

    bt(0)
    return valid


# ────────────────────────────────────────────────────────────────
#  Step 2 — backtracking search: place rows one at a time
# ────────────────────────────────────────────────────────────────

def search(nrows, ncols, fl, strength, valid_rows, time_limit, find_all, log):
    """
    Row-by-row backtracking.
    After each row is placed, column constraints are checked incrementally.
    Returns (solutions, status) where status in {'found','not_found','timeout'}.
    """
    k  = len(fl)
    pair_keys = list(itertools.combinations(range(k), 2)) if strength >= 2 else []
    trip_keys = list(itertools.combinations(range(k), 3)) if strength >= 3 else []

    # Column quotas
    col_lev_quota  = [nrows // q for q in fl]
    col_pair_quota = {(f1, f2): nrows // (fl[f1] * fl[f2]) for f1, f2 in pair_keys}
    col_trip_quota = {(f1,f2,f3): nrows//(fl[f1]*fl[f2]*fl[f3]) for f1,f2,f3 in trip_keys}

    # Running column counts
    # col_lev[j][f][v]     = how many times level v of factor f appears in column j so far
    # col_pair[(f1,f2)][j][(a,b)] = pair count for column j
    col_lev  = [[Counter() for _ in range(k)] for _ in range(ncols)]
    col_pair = {key: [defaultdict(int) for _ in range(ncols)] for key in pair_keys}
    col_trip = {key: [defaultdict(int) for _ in range(ncols)] for key in trip_keys}

    placed = []        # rows placed so far
    solutions = []
    t_start   = time.time()
    nodes     = [0]

    def elapsed():
        return time.time() - t_start

    def place(row):
        for j, t in enumerate(row):
            for f in range(k):
                col_lev[j][f][t[f]] += 1
            for f1, f2 in pair_keys:
                col_pair[(f1,f2)][j][(t[f1],t[f2])] += 1
            for f1, f2, f3 in trip_keys:
                col_trip[(f1,f2,f3)][j][(t[f1],t[f2],t[f3])] += 1
        placed.append(row)

    def unplace(row):
        for j, t in enumerate(row):
            for f in range(k):
                col_lev[j][f][t[f]] -= 1
            for f1, f2 in pair_keys:
                col_pair[(f1,f2)][j][(t[f1],t[f2])] -= 1
            for f1, f2, f3 in trip_keys:
                col_trip[(f1,f2,f3)][j][(t[f1],t[f2],t[f3])] -= 1
        placed.pop()

    def row_compatible(row, row_idx):
        """Check upper-bound column constraints for adding this row."""
        rows_after = row_idx + 1            # rows placed including this one
        remaining  = nrows - rows_after     # rows still to place

        for j, t in enumerate(row):
            # Level upper bound
            for f in range(k):
                new_cnt = col_lev[j][f][t[f]] + 1
                if new_cnt > col_lev_quota[f]:
                    return False
                # Lower-bound forward check: can remaining rows fill the deficit?
                for v in range(fl[f]):
                    deficit = col_lev_quota[f] - (col_lev[j][f][v] + (1 if t[f]==v else 0))
                    if deficit > remaining:
                        return False
            # Pair upper bound
            for f1, f2 in pair_keys:
                if col_pair[(f1,f2)][j][(t[f1],t[f2])] + 1 > col_pair_quota[(f1,f2)]:
                    return False
            # Triplet upper bound
            for f1, f2, f3 in trip_keys:
                if col_trip[(f1,f2,f3)][j][(t[f1],t[f2],t[f3])] + 1 > col_trip_quota[(f1,f2,f3)]:
                    return False
        return True

    def col_complete():
        """Verify all column constraints are exactly met (called at nrows rows placed)."""
        for j in range(ncols):
            for f in range(k):
                for v in range(fl[f]):
                    if col_lev[j][f][v] != col_lev_quota[f]:
                        return False
            for (f1,f2) in pair_keys:
                for a in range(fl[f1]):
                    for b in range(fl[f2]):
                        if col_pair[(f1,f2)][j][(a,b)] != col_pair_quota[(f1,f2)]:
                            return False
            for (f1,f2,f3) in trip_keys:
                for a in range(fl[f1]):
                    for b in range(fl[f2]):
                        for c in range(fl[f3]):
                            if col_trip[(f1,f2,f3)][j][(a,b,c)] != col_trip_quota[(f1,f2,f3)]:
                                return False
        return True

    def bt(row_idx):
        nodes[0] += 1
        if elapsed() > time_limit:
            return 'timeout'
        if row_idx == nrows:
            if col_complete():
                solutions.append([list(r) for r in placed])
                log(f"  ✓ Solution #{len(solutions)} found at {elapsed():.2f}s")
                if not find_all:
                    return 'found'
            return False

        for row in valid_rows:
            if row_compatible(row, row_idx):
                place(row)
                result = bt(row_idx + 1)
                unplace(row)
                if result in ('found', 'timeout'):
                    return result
        return False

    result = bt(0)
    e = elapsed()

    if solutions:
        return solutions, 'found', e, nodes[0]
    elif result == 'timeout':
        return [], 'timeout', e, nodes[0]
    else:
        return [], 'not_found', e, nodes[0]


# ────────────────────────────────────────────────────────────────
#  Verification (independent check on found solution)
# ────────────────────────────────────────────────────────────────

def verify(array, nrows, ncols, fl, strength):
    k = len(fl)
    results = {}

    all_cells = [array[i][j] for i in range(nrows) for j in range(ncols)]
    counts    = Counter(tuple(c) if not isinstance(c, tuple) else c for c in all_cells)
    freqs     = list(counts.values())
    results['treatment_balance'] = (len(set(freqs)) == 1, freqs[0] if freqs else 0)

    row_ok = True
    for f in range(k):
        for i in range(nrows):
            c = Counter(array[i][j][f] for j in range(ncols))
            if set(c.keys()) != set(range(fl[f])) or len(set(c.values())) != 1:
                row_ok = False
    results['row_balance'] = row_ok

    col_ok = True
    for f in range(k):
        for j in range(ncols):
            c = Counter(array[i][j][f] for i in range(nrows))
            if set(c.keys()) != set(range(fl[f])) or len(set(c.values())) != 1:
                col_ok = False
    results['col_balance'] = col_ok

    if strength >= 2:
        s2r = s2c = True
        for f1, f2 in itertools.combinations(range(k), 2):
            q1, q2 = fl[f1], fl[f2]
            all_p = set(itertools.product(range(q1), range(q2)))
            for i in range(nrows):
                c = Counter((array[i][j][f1], array[i][j][f2]) for j in range(ncols))
                if set(c.keys()) != all_p or len(set(c.values())) != 1:
                    s2r = False
            for j in range(ncols):
                c = Counter((array[i][j][f1], array[i][j][f2]) for i in range(nrows))
                if set(c.keys()) != all_p or len(set(c.values())) != 1:
                    s2c = False
        results['strength2_rows'] = s2r
        results['strength2_cols'] = s2c

    if strength >= 3:
        s3r = s3c = True
        for f1, f2, f3 in itertools.combinations(range(k), 3):
            q1, q2, q3 = fl[f1], fl[f2], fl[f3]
            all_t = set(itertools.product(range(q1), range(q2), range(q3)))
            for i in range(nrows):
                c = Counter((array[i][j][f1], array[i][j][f2], array[i][j][f3])
                             for j in range(ncols))
                if set(c.keys()) != all_t or len(set(c.values())) != 1:
                    s3r = False
            for j in range(ncols):
                c = Counter((array[i][j][f1], array[i][j][f2], array[i][j][f3])
                             for i in range(nrows))
                if set(c.keys()) != all_t or len(set(c.values())) != 1:
                    s3c = False
        results['strength3_rows'] = s3r
        results['strength3_cols'] = s3c

    return results


