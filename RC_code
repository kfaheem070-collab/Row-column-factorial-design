"""
Row-Column Factorial Design — Search-Based Program
====================================================
You specify:
  - nrows, ncols  : dimensions of the array
  - factor_levels : list of level counts per factor
  - strength      : 1, 2, or 3
  - time_limit    : seconds before giving up (default 120)

The program searches via backtracking (row-by-row) for a valid design.
It EITHER finds one and writes it to Excel, OR exhausts the search and tells
you the design does not exist, OR reports a timeout if search space is too large.
"""

import itertools, time, sys, random
from collections import Counter, defaultdict
import openpyxl
from openpyxl.styles import PatternFill, Font, Alignment, Border, Side
from openpyxl.utils import get_column_letter

