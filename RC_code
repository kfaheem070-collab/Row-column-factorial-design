    for f in range(len(factor_levels)):
        q    = factor_levels[f]
        fill = FACTOR_FILLS[f % len(FACTOR_FILLS)]
        ws   = wb.create_sheet(f"Factor {f+1}")

        ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=ncols + 1)
