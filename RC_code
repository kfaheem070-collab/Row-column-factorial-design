                c.fill      = fill
                c.font      = Font(name="Arial", size=9)
                c.alignment = Alignment(horizontal="center")
                c.border    = tborder()
            c2 = ws.cell(cur, len(triplets) + 2,
                         "YES ✓" if uniform else "NO ✗")
            c2.fill, c2.font = (PASS_FILL, PASS_FONT) if uniform else (FAIL_FILL, FAIL_FONT)
            c2.alignment = Alignment(horizontal="center")
            cur += 1
        cur += 1


def sheet_readme(wb, nrows, ncols, factor_levels, strength):
    ws  = wb.create_sheet("README")
    k   = len(factor_levels)
    prod = 1
    for q in factor_levels: prod *= q

    lines = [
        ("Row-Column Factorial Design — User Guide", True, 14),
        ("", False, 10),
        ("WHAT IS THIS DESIGN?", True, 11),
        ("A row-column factorial design arranges experimental treatments in a two-way "
         "grid (rows × columns). Each cell holds one run described by a tuple of factor "
         "levels. The design is constructed so that:", False, 10),
        ("", False, 10),
        ("  1. TREATMENT BALANCE: Every possible treatment tuple appears the same number "
         "of times across the whole array.", False, 10),
        ("  2. ROW MARGINAL BALANCE: For every factor, each level appears equally often "
         "in each row.", False, 10),
        ("  3. COLUMN MARGINAL BALANCE: For every factor, each level appears equally "
         "often in each column.", False, 10),
        (f"  4. STRENGTH {strength}: For any {strength} factor positions chosen, every "
         f"ordered {strength}-tuple of levels appears equally often in each row AND in "
         "each column.", False, 10),
        ("", False, 10),
        ("THIS WORKBOOK", True, 11),
        (f"  • Design Array    — the full {nrows}×{ncols} array (entries = level tuples)", False, 10),
        (f"  • Factor 1 … {k}  — separate grid for each factor's level pattern", False, 10),
        ("  • Verification    — automated PASS/FAIL for every design property", False, 10),
        ("  • Row Freq Tables — marginal counts per row (should be uniform)", False, 10),
        ("  • Col Freq Tables — marginal counts per column (should be uniform)", False, 10),
    ]
    if strength >= 2:
        lines += [
            ("  • Pair Freq (Row) / (Col) — ordered-pair counts (strength-2 check)", False, 10),
        ]
    if strength >= 3:
        lines += [
            ("  • Triplet Freq (Row) / (Col) — ordered-triplet counts (strength-3 check)", False, 10),
        ]
    lines += [
        ("", False, 10),
        ("HOW TO CUSTOMISE", True, 11),
        ("Edit the four CONFIG lines at the top of the Python script:", False, 10),
        ("  NUM_ROWS       = number of rows", False, 10),
        ("  NUM_COLS       = number of columns", False, 10),
        ("  FACTOR_LEVELS  = list of level counts, e.g. [4, 3, 3, 3]", False, 10),
        ("  TARGET_STRENGTH = 1, 2, or 3", False, 10),
        ("", False, 10),
        ("DIVISIBILITY RULE", True, 11),
        ("For a strength-t design with factor levels q1, q2, …, qk the dimensions "
         "nrows and ncols must each be divisible by the product of every t or fewer "
         "of the qi values.", False, 10),
        (f"For this design ({factor_levels}, strength {strength}) the minimum valid "
         f"dimension is {minimum_dimension(factor_levels, strength)}.", False, 10),
        ("", False, 10),
        ("CONSTRUCTION METHOD", True, 11),
        ("Generalised cyclic array: cell(i,j)[f] = (i + c_f·j) mod q_f where c_f "
         "is the smallest integer coprime to q_f. This closed-form formula guarantees "
         "all balance properties algebraically.", False, 10),
    ]

    for r_idx, (text, bold, size) in enumerate(lines, 1):
        c = ws.cell(r_idx, 1, text)
        c.font = Font(name="Arial", bold=bold, size=size,
                      color="1F3864" if bold else "000000")
        ws.row_dimensions[r_idx].height = 16 if text else 8
    ws.column_dimensions["A"].width = 95


# ── Main ─────────────────────────────────────────────────────────

def main():
    nrows = NUM_ROWS
    ncols = NUM_COLS
    fl    = FACTOR_LEVELS
    sth   = TARGET_STRENGTH

    print(f"Row-Column Factorial Design Generator")
    print(f"  Rows={nrows}, Cols={ncols}, Factors={len(fl)}, "
          f"Levels={fl}, Strength={sth}")
    print()

    try:
        check_divisibility(nrows, ncols, fl, sth)
    except ValueError as e:
        print(f"Configuration ERROR:\n{e}")
        return

    array   = build_design(nrows, ncols, fl)
    results = verify(array, nrows, ncols, fl, sth)

    print("Verification results:")
    for key, val in results.items():
        ok = val[0] if isinstance(val, tuple) else val
        print(f"  {'✓' if ok else '✗'} {key}")
    print()

    wb = openpyxl.Workbook()
    sheet_design(wb, array, nrows, ncols, fl, sth)
    sheet_factor(wb, array, nrows, ncols, fl)
    sheet_verification(wb, results, nrows, ncols, fl, sth)
    sheet_freq(wb, array, nrows, ncols, fl, by="row")
    sheet_freq(wb, array, nrows, ncols, fl, by="col")
    if sth >= 2:
        sheet_pair_freq(wb, array, nrows, ncols, fl, by="row", strength=sth)
        sheet_pair_freq(wb, array, nrows, ncols, fl, by="col", strength=sth)
    if sth >= 3:
        sheet_triplet_freq(wb, array, nrows, ncols, fl, by="row")
        sheet_triplet_freq(wb, array, nrows, ncols, fl, by="col")
    sheet_readme(wb, nrows, ncols, fl, sth)

    wb.save(OUTPUT_FILE)
    print(f"Saved to: {OUTPUT_FILE}")


if __name__ == "__main__":
    main()
