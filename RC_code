def main():
    nrows  = NROWS
    ncols  = NCOLS
    fl     = FACTOR_LEVELS
    sth    = STRENGTH
    tlimit = TIME_LIMIT
    k      = len(fl)

    logs = []
    def log(msg):
        print(msg)
        logs.append(msg)

    log("=" * 60)
    log("Row-Column Factorial Design — Backtracking Search")
    log("=" * 60)
    log(f"  nrows={nrows}, ncols={ncols}")
    log(f"  factors={k},  levels={fl}")
    log(f"  strength={sth},  time_limit={tlimit}s")
    log("")

    # Step 0: feasibility
    ok, reasons = feasibility_check(nrows, ncols, fl, sth)
    if not ok:
        log("INFEASIBLE — divisibility conditions not met:")
        for r in reasons:
            log(f"  • {r}")
        wb = openpyxl.Workbook()
        write_not_found_workbook(wb, nrows, ncols, fl, sth,
                                  'infeasible', 0, 0, reasons, 0)
        wb.save(OUTPUT_FILE)
        log(f"\nReport saved to {OUTPUT_FILE}")
        return

    # Step 1: generate valid rows
    log("Step 1: Generating all valid row configurations ...")
    t0 = time.time()
    valid_rows = generate_valid_rows(ncols, fl, sth)
    t1 = time.time()
    log(f"  → {len(valid_rows)} valid row templates found in {t1-t0:.2f}s")

    if not valid_rows:
        log("\nNo valid row configurations exist — design cannot be built.")
        wb = openpyxl.Workbook()
        write_not_found_workbook(wb, nrows, ncols, fl, sth,
                                  'not_found', t1-t0, 0, [], 0)
        wb.save(OUTPUT_FILE)
        log(f"Report saved to {OUTPUT_FILE}")
        return

    # Step 2: search
    log(f"\nStep 2: Backtracking search (time limit: {tlimit}s) ...")
    solutions, status, elapsed, nodes = search(
        nrows, ncols, fl, sth, valid_rows, tlimit, FIND_ALL, log)

    log(f"\n  → Status : {status.upper()}")
    log(f"  → Time   : {elapsed:.3f}s")
    log(f"  → Nodes  : {nodes:,}")

    wb = openpyxl.Workbook()

    if solutions:
        array = solutions[0]
        log("\nStep 3: Verifying solution independently ...")
        ver = verify(array, nrows, ncols, fl, sth)
        all_ok = all(v[0] if isinstance(v, tuple) else v for v in ver.values())
        for prop, result in ver.items():
            ok2 = result[0] if isinstance(result, tuple) else result
            log(f"  {'✓' if ok2 else '✗'} {prop}")
        log(f"\n  → {'ALL PROPERTIES VERIFIED ✓' if all_ok else 'VERIFICATION FAILED ✗'}")
        write_found_workbook(wb, array, nrows, ncols, fl, sth,
                              elapsed, nodes, ver, len(valid_rows))
    else:
        write_not_found_workbook(wb, nrows, ncols, fl, sth,
                                  status, elapsed, nodes, [], len(valid_rows))

    wb.save(OUTPUT_FILE)
    log(f"\nSaved to {OUTPUT_FILE}")


if __name__ == "__main__":
    main()
