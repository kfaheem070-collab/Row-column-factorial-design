    k = len(factor_levels)

    # Title
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=ncols + 1)
    c = ws.cell(1, 1,
        f"Row-Column Factorial Design  |  "
        f"{nrows}×{ncols}  |  {k} Factors {factor_levels}  |  Strength {strength}")
    c.font      = Font(name="Arial", bold=True, size=13, color="1F3864")
    c.alignment = Alignment(horizontal="center")
    ws.row_dimensions[1].height = 26

    ws.cell(2, 1, "Cell entries show (F1, F2, …, Fk) level tuple (0-indexed)."
        ).font = Font(name="Arial", italic=True, size=9, color="555555")
    ws.row_dimensions[3].height = 6   # spacer

    # Column headers
    set_hdr(ws.cell(4, 1), "Row \\ Col")
    ws.column_dimensions["A"].width = 10
    for j in range(ncols):
        set_hdr(ws.cell(4, j + 2), f"C{j+1}")
        ws.column_dimensions[get_column_letter(j + 2)].width = max(12, 3 * k + 3)

    # Data
    for i in range(nrows):
        set_sub(ws.cell(i + 5, 1), f"R{i+1}")
        for j in range(ncols):
            tup  = array[i][j]
            text = "(" + ",".join(str(v) for v in tup) + ")"
            c = ws.cell(i + 5, j + 2, text)
            c.font      = Font(name="Arial", size=10)
            c.alignment = Alignment(horizontal="center")
            c.border    = tborder()
            if i % 2 == 0:
                c.fill = ALT_FILL
        ws.row_dimensions[i + 5].height = 18

    # Design info block (below)
    info_row = nrows + 7
    ws.cell(info_row,     1, "Design Parameters").font = LBL_FONT
    ws.cell(info_row + 1, 1, f"Rows (R):").font = CELL_FONT
    ws.cell(info_row + 1, 2, nrows).font = CELL_FONT
    ws.cell(info_row + 2, 1, "Columns (C):").font = CELL_FONT
    ws.cell(info_row + 2, 2, ncols).font = CELL_FONT
    ws.cell(info_row + 3, 1, "Number of factors (k):").font = CELL_FONT
    ws.cell(info_row + 3, 2, k).font = CELL_FONT
    ws.cell(info_row + 4, 1, "Factor level counts:").font = CELL_FONT
    ws.cell(info_row + 4, 2, str(factor_levels)).font = CELL_FONT
    ws.cell(info_row + 5, 1, "Strength:").font = CELL_FONT
    ws.cell(info_row + 5, 2, strength).font = CELL_FONT
    ws.cell(info_row + 6, 1, "Total treatments:").font = CELL_FONT
    prod = 1
    for q in factor_levels: prod *= q
    ws.cell(info_row + 6, 2, prod).font = CELL_FONT
    ws.cell(info_row + 7, 1, "Total cells:").font = CELL_FONT
    ws.cell(info_row + 7, 2, nrows * ncols).font = CELL_FONT
    rep = (nrows * ncols) // prod
    ws.cell(info_row + 8, 1, "Each treatment repeats:").font = CELL_FONT
    ws.cell(info_row + 8, 2, f"{rep} time(s)").font = CELL_FONT


