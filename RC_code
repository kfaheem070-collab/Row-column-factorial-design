def sheet_verification(wb, results, nrows, ncols, factor_levels, strength):
    ws = wb.create_sheet("Verification")
    k  = len(factor_levels)

    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=5)
    t = ws.cell(1, 1, "Design Verification Report")
    t.font = Font(name="Arial", bold=True, size=14, color="1F3864")
    t.alignment = Alignment(horizontal="center")
    ws.row_dimensions[1].height = 26

    ws.column_dimensions["A"].width = 50
    ws.column_dimensions["B"].width = 14
    ws.column_dimensions["C"].width = 70
    ws.column_dimensions["D"].width = 12

    def hdr(r, texts):
        for ci, txt in enumerate(texts, 1):
            set_hdr(ws.cell(r, ci), txt)

    def prow(r, label, ok, detail=""):
        ws.cell(r, 1, label).font = CELL_FONT
        c = ws.cell(r, 2, "PASS ✓" if ok else "FAIL ✗")
        c.fill, c.font = (PASS_FILL, PASS_FONT) if ok else (FAIL_FILL, FAIL_FONT)
        c.alignment = Alignment(horizontal="center")
        ws.cell(r, 3, detail).font = Font(name="Arial", size=9, color="333333")
        ws.row_dimensions[r].height = 18

    hdr(3, ["Property", "Status", "Detail / Interpretation"])
    r = 4

    ok, counts = results["treatment_balance"]
    freqs = list(counts.values())
    prow(r, "Each treatment appears equally often in the array",
         ok, f"Repetition frequency = {freqs[0]}" if ok else f"Unequal counts: max={max(freqs)}, min={min(freqs)}")
    r += 1

    prow(r, "Each factor level appears equally often in every ROW",
         results["row_factor_balance"],
         "Each level of factor f appears ncols/q_f times per row")
    r += 1

    prow(r, "Each factor level appears equally often in every COLUMN",
         results["col_factor_balance"],
         "Each level of factor f appears nrows/q_f times per column")
    r += 1

    if strength >= 2:
        prow(r, "Strength-2: every ordered pair of levels balanced in each ROW",
             results.get("strength2_rows", False),
             "For any 2 factor positions, each ordered pair appears equally often in each row")
        r += 1
        prow(r, "Strength-2: every ordered pair of levels balanced in each COLUMN",
             results.get("strength2_cols", False),
             "For any 2 factor positions, each ordered pair appears equally often in each column")
        r += 1

    if strength >= 3:
        prow(r, "Strength-3: every ordered triplet balanced in each ROW",
             results.get("strength3_rows", False),
             "For any 3 factor positions, each ordered triplet appears equally often in each row")
        r += 1
        prow(r, "Strength-3: every ordered triplet balanced in each COLUMN",
             results.get("strength3_cols", False),
             "For any 3 factor positions, each ordered triplet appears equally often in each column")
        r += 1

    all_ok = all([
        results["treatment_balance"][0],
        results["row_factor_balance"],
        results["col_factor_balance"],
        results.get("strength2_rows", True),
        results.get("strength2_cols", True),
        results.get("strength3_rows", True),
        results.get("strength3_cols", True),
    ])
    r += 1
    ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=3)
    msg = "✓  All required design properties are satisfied!" if all_ok \
          else "✗  One or more design properties NOT satisfied — see rows above."
    c = ws.cell(r, 1, msg)
    c.fill      = PASS_FILL if all_ok else FAIL_FILL
    c.font      = Font(name="Arial", bold=True, size=12,
                       color="006100" if all_ok else "9C0006")
    c.alignment = Alignment(horizontal="center")
    ws.row_dimensions[r].height = 24


def sheet_freq(wb, array, nrows, ncols, factor_levels, by="row"):
    label = "Row" if by == "row" else "Col"
    ws    = wb.create_sheet(f"{label} Freq Tables")

    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=10)
    t = ws.cell(1, 1, f"Level Frequency per {label} — marginal balance check")
    t.font = Font(name="Arial", bold=True, size=13, color="1F3864")
    t.alignment = Alignment(horizontal="center")

    cur = 3
    k   = len(factor_levels)
    for f in range(k):
        q    = factor_levels[f]
        fill = FACTOR_FILLS[f % len(FACTOR_FILLS)]

        ws.cell(cur, 1, f"Factor {f+1}  ({q} levels)").font = LBL_FONT
        cur += 1

        set_hdr(ws.cell(cur, 1), label)
        ws.column_dimensions["A"].width = 10
        for lvl in range(q):
            set_hdr(ws.cell(cur, lvl + 2), f"Level {lvl}")
            ws.column_dimensions[get_column_letter(lvl + 2)].width = 11
        set_hdr(ws.cell(cur, q + 2), "Uniform?")
        ws.column_dimensions[get_column_letter(q + 2)].width = 12
        cur += 1

        outer = range(nrows) if by == "row" else range(ncols)
        for idx in outer:
            if by == "row":
                cnt = Counter(array[idx][j][f] for j in range(ncols))
            else:
                cnt = Counter(array[i][idx][f] for i in range(nrows))

            set_sub(ws.cell(cur, 1), f"{'R' if by=='row' else 'C'}{idx+1}")
            vals = [cnt.get(lvl, 0) for lvl in range(q)]
            uniform = len(set(vals)) == 1
            for lvl in range(q):
                c = ws.cell(cur, lvl + 2, vals[lvl])
                c.fill      = fill
                c.font      = Font(name="Arial", size=10)
                c.alignment = Alignment(horizontal="center")
                c.border    = tborder()
            c2 = ws.cell(cur, q + 2, "YES ✓" if uniform else "NO ✗")
            c2.fill, c2.font = (PASS_FILL, PASS_FONT) if uniform else (FAIL_FILL, FAIL_FONT)
            c2.alignment = Alignment(horizontal="center")
            cur += 1
        cur += 1


